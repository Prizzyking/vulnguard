# Copy to .env and replace every placeholder before starting the team stack.
# Use long random hexadecimal values; never commit the populated .env file.
VULNGUARD_HOST=vulnguard.example.com
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX_SECRET
VULNGUARD_SECRET_KEY=REPLACE_WITH_AT_LEAST_64_RANDOM_HEX_CHARACTERS
VULNGUARD_BOOTSTRAP_TOKEN=REPLACE_WITH_ONE_TIME_RANDOM_HEX_TOKEN
VULNGUARD_ALLOWED_ORIGINS=https://vulnguard.example.com
VULNGUARD_ENV=production
VULNGUARD_COOKIE_SECURE=true
